# name: test/sql/pls_multivariate.test
# description: Multiresponse NIPALS/SIMPLS, VIP, portable PLS-DA and inference
# group: [sql]

require ducksmiles

require json

query I
SELECT abs(json_extract(chem_pls2_fit([[-2.,-3.,4.],[-1.,-1.,2.],[0.,2.,2.],[1.,3.,1.],[2.,6.,0.]],[2.,1.]),'$.coefficients[0][0]')::DOUBLE-2.2)<1e-10;
----
true

query II
WITH model AS (SELECT chem_pls2_fit([[-2.,-3.,4.],[-1.,-1.,2.],[0.,2.,2.],[1.,3.,1.],[2.,6.,0.]],[2.,1.,1.]) AS j), prediction AS (SELECT chem_pls2_predict([[1.]],json_extract(j,'$.predict_parameters')::DOUBLE[]) AS j FROM model)
SELECT abs(json_extract(j,'$.predictions[0][0]')::DOUBLE-3.6)<1e-10,abs(json_extract(j,'$.mean_standard_error[0][0]')::DOUBLE-sqrt(.08))<1e-10 FROM prediction;
----
true	true

query I
WITH model AS (SELECT chem_plsda_fit([[-3.,10.],[-2.,10.],[-1.,10.],[1.,30.],[2.,30.],[3.,30.]],[1.]) AS j)
SELECT json_extract(chem_plsda_predict([[-7.],[7.]],json_extract(j,'$.predict_parameters')::DOUBLE[]),'$.predicted_labels')='[10,30]'::JSON FROM model;
----
true

query IIII
SELECT chem_pls2_fit([[0.,1.],[1.,2.]],[1.,0.]) IS NULL,
       chem_plsda_fit([[0.,10.],[1.,10.]],[1.]) IS NULL,
       chem_pls2_predict([[1.]],[]::DOUBLE[]) IS NULL,
       chem_pls2_fit([[0.,NULL],[1.,2.]],[1.,1.]) IS NULL;
----
true	true	true	true

query I
SELECT count(*) FROM (
 SELECT chem_pls2_fit([[0.,i::DOUBLE],[1.,i+1.],[2.,i+2.]],[1.,1.]) AS j
 FROM range(5000) t(i) WHERE i%997=0
) WHERE json_valid(j);
----
6

query I
SELECT chem_analyze('pls2_fit',[[0.,1.],[1.,3.],[2.,5.]],[1.,1.])=chem_pls2_fit([[0.,1.],[1.,3.],[2.,5.]],[1.,1.]);
----
true
