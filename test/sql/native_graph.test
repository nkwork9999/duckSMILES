# name: test/sql/native_graph.test
# group: [sql]

require ducksmiles

# Exercise the graph without auto-installing/loading any optional extension.
statement ok
SET autoinstall_known_extensions=false;

statement ok
SET autoload_known_extensions=false;

query T
SELECT regexp_extract(mol_graph_json('CN'), '"schema":"([^"]+)"', 1);
----
ducksmiles-native-graph-v1

query III
SELECT regexp_extract(mol_graph_json('CN'), '"atom_count":([0-9]+)', 1)::INTEGER,
       regexp_extract(mol_graph_json('[H]N([H])[H]'), '"atom_count":([0-9]+)', 1)::INTEGER,
       regexp_extract(mol_graph_json('[NH4+]'), '"bracket_h_count":([0-9]+)', 1)::INTEGER;
----
2	4	4

query II
SELECT regexp_extract(mol_graph_json('[NH4+].[Cl-]'), '"index":0,"symbol":"N"[^}]*"formal_charge":(-?[0-9]+)', 1)::INTEGER,
       regexp_extract(mol_graph_json('[NH4+].[Cl-]'), '"index":1,"symbol":"Cl"[^}]*"formal_charge":(-?[0-9]+)', 1)::INTEGER;
----
1	-1

query IT
SELECT regexp_extract(mol_graph_json('[13C@@H:7](N)(C)O'), '"isotope":([0-9]+)', 1)::INTEGER,
       regexp_extract(mol_graph_json('[13C@@H:7](N)(C)O'), '"chirality_token":"([^"]+)"', 1);
----
13	@@

query T
SELECT regexp_extract(mol_graph_json('c1ncccc1'), '"bond_type":"([^"]+)"', 1);
----
aromatic

query IIII
SELECT mol_graph_json(NULL) IS NULL, mol_graph_json('C=') IS NULL,
       mol_graph_json('[*]') IS NULL, mol_graph_json(repeat('C', 257)) IS NULL;
----
true	true	true	true

query I
SELECT count(*) FILTER (WHERE mol_graph_json(s) IS NULL)
FROM (VALUES ('CN'), (NULL), ('invalid'), ('[NH4+]')) t(s);
----
2

query II
SELECT regexp_extract(mol_graph_json('CN'), '"pretrained_tensor_compatible":(true|false)', 1)::BOOLEAN,
       regexp_extract(mol_graph_json('CN'), '"gasteiger":(true|false)', 1)::BOOLEAN;
----
false	false
