# name: test/sql/jmp_analytics.test
# description: Public JMP-style analytics SQL boundary and vector execution
# group: [sql]

require ducksmiles

require json

# Generic and named entry points have the same checked numerical dispatch.
query I
SELECT chem_analyze('box_behnken',[[-1.,1.],[-1.,1.],[-1.,1.]],[]::DOUBLE[])
     = chem_box_behnken([[-1.,1.],[-1.,1.],[-1.,1.]],[]::DOUBLE[]);
----
true

query I
SELECT json_extract_string(chem_box_behnken([[-1.,1.],[-1.,1.],[-1.,1.]],[]::DOUBLE[]),'$.run_count')::INTEGER;
----
13

# Nested NULL, ragged rows and nonfinite inputs must never enter numerical code.
query IIII
SELECT chem_linear_model([[1.,NULL],[2.,3.],[3.,4.]],[]::DOUBLE[]) IS NULL,
       chem_cox_ph([[1.,2.,1.],[2.,3.]],[]::DOUBLE[]) IS NULL,
       chem_fit_normal([['Infinity'::DOUBLE],[2.]],[]::DOUBLE[]) IS NULL,
       chem_mlp([[1.,1.],[2.,2.],[3.,0.]],NULL::DOUBLE[]) IS NULL;
----
true	true	true	true

# Bad options become NULL without affecting the valid rows in the same vector.
query II rowsort
SELECT i, chem_one_sample_t([[1.],[2.],[3.]], [0.,confidence]) IS NULL
FROM (VALUES (0,0.95),(1,2.0),(2,NULL)) t(i,confidence);
----
0	false
1	true
2	true

query I
SELECT count(*) FROM (
  SELECT chem_one_sample_t([[i::DOUBLE],[i+1.0],[i+2.0]],[0.]) AS result
  FROM range(5000) t(i) WHERE i % 997 = 0
) WHERE json_valid(result);
----
6

# Stored numerical model parameters cross the JSON -> DOUBLE[] boundary.
query T
SELECT json_extract_string(chem_cox_predict([[0.],[1.],[2.]],
       from_json('[0.8,0.6931471805599453,0.0,0.0]','["DOUBLE"]')), '$.version');
----
1

# Training uses only the prefix; placeholder query labels cannot change a fit.
query I
SELECT chem_decision_tree([[0.,1.],[1.,3.],[2.,5.],[3.,7.],[1.5,0.]], [4.,3.,1.,0.])
     = chem_decision_tree([[0.,1.],[1.,3.],[2.,5.],[3.,7.],[1.5,999999.]], [4.,3.,1.,0.]);
----
true

# Impossible bounded mixtures are rejected even when the total is very small.
query I
SELECT chem_mixture_lattice([[1e-15,1e-15],[1e-15,1e-15]], [2.,1e-100]) IS NULL;
----
true
