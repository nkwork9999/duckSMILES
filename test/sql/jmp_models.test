# name: test/sql/jmp_models.test
# description: Mixed, causal and omics functions through SQL and saved models
# group: [sql]

require ducksmiles

require json

query I
SELECT abs(json_extract(chem_item_reliability([[0.,0.,0.],[1.,2.,1.],[2.,4.,0.],[3.,6.,1.]],[]::DOUBLE[]),'$.alpha')::DOUBLE-0.75)<1e-12;
----
true

query I
SELECT abs(json_extract(chem_repeated_covariance([[0.],[1.],[2.]], [4.,1.,0.5]),'$.covariance[0][2]')::DOUBLE-0.25)<1e-12;
----
true

query I
SELECT abs(json_extract(chem_assay_normalize([[1.,3.]], [3.,1000.,2000.]),'$.rows[0][0]')::DOUBLE-400000.)<1e-6;
----
true

query I
WITH model AS (SELECT chem_quantile_normalize([[1.,1.,5.],[2.,4.,6.]],[]::DOUBLE[]) AS value)
SELECT abs(json_extract(chem_quantile_normalize_predict([[4.,4.,0.]],json_extract(value,'$.reference_quantiles')::DOUBLE[]),'$.rows[0][0]')::DOUBLE-4.)<1e-12 FROM model;
----
true

query I
WITH model AS (SELECT chem_marker_admixture([[0.,0.],[1.,2.],[2.,-1.]], [1.,1000.,1e-9,42.,1.]) AS value)
SELECT json_extract(chem_admixture_predict([[0.,2.]],json_extract(value,'$.predict_parameters')::DOUBLE[]),'$.ancestry[0][0]')::DOUBLE=1. FROM model;
----
true

query III
SELECT chem_ipw_effect([[4.,1.,0.],[1.,0.,0.5]],[]::DOUBLE[]) IS NULL,
       chem_assay_normalize([[0.,0.]], [1.]) IS NULL,
       chem_repeated_covariance([[0.],[1.]], [4.,1.,1.]) IS NULL;
----
true	true	true

query I
SELECT count(*) FROM (
 SELECT chem_assay_normalize([[i::DOUBLE+1.,3.]], [1.]) AS result
 FROM range(5000) t(i) WHERE i%997=0
) WHERE json_valid(result);
----
6
