# name: test/sql/analytics.test
# description: SQL analytics integration, nested nulls and selected vectors
# group: [sql]

require ducksmiles

query I
SELECT chem_acquisition([[2.0,1.0]], [2.0,0.0,0.0]) LIKE '%0.398942280%';
----
true

query I
SELECT chem_pca([[1.0,2.0],[2.0,4.0],[3.0,6.0]], [1.0,0.0]) IS NOT NULL;
----
true

query IIII
SELECT chem_pca(NULL::DOUBLE[][],[1.0,0.0]) IS NULL,
       chem_pca([[1.0,NULL],[2.0,3.0]],[1.0,0.0]) IS NULL,
       chem_pca([[1.0],[2.0,3.0]],[1.0,0.0]) IS NULL,
       chem_analyze('unknown',[[1.0]],[]::DOUBLE[]) IS NULL;
----
true	true	true	true

query I
SELECT count(*) FROM (SELECT i, chem_acquisition([[i::DOUBLE,1.0]], [0.0,0.0,0.0]) AS value FROM range(5000) t(i) WHERE i % 997 = 0) WHERE value IS NOT NULL;
----
6

query I
WITH molecules(id,smiles) AS (VALUES (1,'CCO'),(2,'CCN'),(3,'CCC'),(4,'c1ccccc1'))
SELECT chem_pca(list([mol_weight(smiles),logp_crippen(smiles)] ORDER BY id),[2.0,1.0]) IS NOT NULL FROM molecules;
----
true
