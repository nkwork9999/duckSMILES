# name: test/sql/zero_inflation.test
# description: All five zero-inflated CPU families,portable prediction and malformed SQL
# group: [sql]

require ducksmiles

require json

query I
SELECT abs(json_extract(chem_zi_poisson([[0.,1.,10.],[1.,1.,3.],[2.,1.,4.],[3.,1.,2.],[4.,1.,1.]],[]::DOUBLE[]),'$.pi')::DOUBLE-.39177549201032386)<1e-6;
----
true

query I
SELECT abs(json_extract(chem_zi_binomial([[0.,4.,39072.],[1.,4.,24192.],[2.,4.,24192.],[3.,4.,10752.],[4.,4.,1792.]],[]::DOUBLE[]),'$.pi')::DOUBLE-.3)<1e-6;
----
true

query I
SELECT abs(json_extract(chem_zi_beta_binomial([[0.,4.,7212.],[1.,4.,2992.],[2.,4.,2652.],[3.,4.,1872.],[4.,4.,897.]],[]::DOUBLE[]),'$.dispersion')::DOUBLE-.2)<1e-6;
----
true

query I
SELECT abs(json_extract(chem_zi_negative_binomial([[0.,1.,47500.],[1.,1.,17500.],[2.,1.,13125.],[3.,1.,8750.],[4.,1.,5469.],[5.,1.,3281.],[6.,1.,1914.],[7.,1.,1094.],[8.,1.,615.],[9.,1.,342.],[10.,1.,188.],[11.,1.,103.],[12.,1.,56.],[13.,1.,30.],[14.,1.,16.],[15.,1.,9.],[16.,1.,5.],[17.,1.,2.],[18.,1.,1.],[19.,1.,1.]],[]::DOUBLE[]),'$.dispersion')::DOUBLE-.49988967519193705)<1e-6;
----
true

query I
SELECT abs(json_extract(chem_zi_gamma([[0.,1.,3.],[1.,1.,2.],[2.,1.,3.],[3.,1.,2.]],[]::DOUBLE[]),'$.dispersion')::DOUBLE-.32025426596168105)<1e-6;
----
true

query I
WITH fit AS (SELECT chem_zi_poisson([[0.,1.,10.],[1.,1.,3.],[2.,1.,4.],[3.,1.,2.],[4.,1.,1.]],[]::DOUBLE[]) AS model)
SELECT abs(json_extract(chem_zi_predict([[1.,0.,.5]],json_extract(model,'$.predict_parameters')::DOUBLE[]),'$.mixture_mean[0]')::DOUBLE-1.05)<1e-6 FROM fit;
----
true

query IIII
SELECT chem_zi_poisson([[0.,1.,10.]],[]::DOUBLE[]) IS NULL,
       chem_zi_binomial([[0.,1.,5.],[1.,1.,5.]],[]::DOUBLE[]) IS NULL,
       chem_zi_gamma([[1.,1.,3.],[1.,1.,4.]],[]::DOUBLE[]) IS NULL,
       chem_zi_predict([[1.,NULL,.5]],[]::DOUBLE[]) IS NULL;
----
true	true	true	true

query I
SELECT count(*) FROM (
 SELECT chem_zi_predict([[1.,i::DOUBLE,.5]],[1.,2.,0.,.95,0.,0.,0.,ln(2.),0.,.3,0.,0.,0.,0.]) AS result
 FROM range(5000) t(i) WHERE i%997=0
) WHERE json_valid(result);
----
6

query I
SELECT chem_analyze('zi_poisson',[[0.,1.,10.],[1.,1.,3.],[2.,1.,4.],[3.,1.,2.],[4.,1.,1.]],[]::DOUBLE[])=chem_zi_poisson([[0.,1.,10.],[1.,1.,3.],[2.,1.,4.],[3.,1.,2.],[4.,1.,1.]],[]::DOUBLE[]);
----
true
