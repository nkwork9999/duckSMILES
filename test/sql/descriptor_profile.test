# name: test/sql/descriptor_profile.test
# group: [sql]

require ducksmiles

require json

query III
SELECT json_array_length(c, '$.descriptors'), json_array_length(v),
       (json_extract_string(c, '$.descriptors[0].id') = 'MolWt')::INTEGER
FROM (SELECT mol_descriptor_catalog_json() c, mol_descriptor_values_json('CCO') v);
----
291	291	1

query II
SELECT (round(json_extract(v, '$[0]')::DOUBLE, 3) = 46.069)::INTEGER,
       json_extract(v, '$[6]')::INTEGER
FROM (SELECT mol_descriptor_values_json('CCO') v);
----
1	3

query I
SELECT count(mol_descriptor_values_json(s)) FROM (VALUES
  (NULL::VARCHAR), ('C1'), (''), ('CCO'), ('c1ccccc1')) t(s);
----
2
