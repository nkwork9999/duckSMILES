# name: test/sql/required_extensions.test
# group: [sql]

# Required extensions must load successfully; a require directive could skip.
# This build-directory spelling works in both DuckDB 1.5 and 2 test runners.
statement ok
LOAD '__BUILD_DIRECTORY__/extension/ducksmiles/ducksmiles.duckdb_extension';

# Static registration makes JSON available for LOAD, not necessarily loaded.
statement ok
LOAD json;

query I
SELECT json_extract('{"v":1}', '$.v')::INTEGER;
----
1
