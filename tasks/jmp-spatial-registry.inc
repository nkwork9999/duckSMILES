// Four isotropic spatial covariance / known-covariance regression operations.
ANALYTICS_METHOD(SpatialCovariance,"chem_spatial_covariance","spatial_covariance","Four isotropic JMP spatial kernels: locations in1..3 dimensions; [kind0spherical/1exponential/2Gaussian/3power,partial_sill,nugget,rho]. Independent record nugget; covariance and semivariance matrices.","chem_spatial_covariance([[0],[1],[0]], [0,4,1,2])")
ANALYTICS_METHOD(SpatialVariogram,"chem_spatial_variogram","spatial_variogram","Empirical isotropic Matheron semivariogram: rows[coordinates1..3,response]; [bins=10,lower=min_pair_distance,upper=max_pair_distance]. Pair counts,mean distance and half mean squared differences; empty classes null.","chem_spatial_variogram([[0,0],[1,2],[2,4]], [2])")
ANALYTICS_METHOD(SpatialGLS,"chem_spatial_gls","spatial_gls","Gaussian GLS with supplied absolute isotropic spatial covariance; rows[coordinates,fixed features,response]; [dimensions1..3,features0..12,kind,sill,nugget,rho]. Fixed effects,covariance,likelihood and reusable universal-kriging parameters; no covariance estimation.","chem_spatial_gls([[0,1],[1,2],[2,6]], [1,0,0,2,1,1])")
ANALYTICS_METHOD(SpatialPredict,"chem_spatial_predict","spatial_predict","Saved spatial GLS universal-kriging prediction: rows[coordinates,fixed features]; unchanged spatial_gls.predict_parameters. Mean,latent and independent-observation variances include fixed-effect uncertainty given supplied covariance.","chem_spatial_predict([[0],[10]], [1,3,1,0,0,2,1,1,3,0,1,2,1,1,1,-2,-1.0000000000000002,3,1,0,1,0,0,1,0.33333333333333337])")
