// Estimated isotropic Gaussian spatial regression, distinct from supplied covariance.
ANALYTICS_METHOD(SpatialFit,"chem_spatial_fit","spatial_fit","Profile Gaussian ML/REML spatial regression: rows[coordinates,fixed features,subject,response]; [dimensions1..3,features0..8,kind0..3,reml0/1,nugget0/1,maxiter=1000,tol=1e-8,optional_length_lower,upper]. Estimated sill/range/nugget,interior observed-information Wald intervals and saved prediction; n<=96.","chem_spatial_fit([[0,0,1],[1,0,2],[2,0,6]], [1,0,0,0,0,100,1e-8,0.1,0.5])")
ANALYTICS_METHOD(SpatialFitPredict,"chem_spatial_fit_predict","spatial_fit_predict","Reuse estimated spatial fit: rows[coordinates,fixed features,subject]; unchanged fit.predict_parameters. Plug-in universal kriging mean,latent and independent-observation variances; covariance-estimation uncertainty excluded.","chem_spatial_fit_predict([[10,0]], [1,1,0,3,0,4.666666666666667,0,0.1,0,0,1,1,0,2,2,0,6])")
