ANALYTICS_METHOD(TextLatentClass,"chem_text_latent_class","text_latent_class","Conditional-independence Bernoulli mixture EM on supplied count presence; args[k,seed=0,max_iter=200,tol=1e-8,probability_floor=1e-9]. Reports genuine likelihood,mixture/term probabilities and saved posterior model.","chem_text_latent_class([[2,1,0],[0,1,3],[0,0,0]], [1,0,200,1e-10,1e-08])")
