ANALYTICS_METHOD(TextWeightPredict,"chem_text_weight_predict","text_weight_predict","Apply saved dictionary and training IDF to new count rows; args unchanged text_weight.weight_parameters; training vocabulary width/order required.","chem_text_weight_predict([[0,4,2]], [1,3,3,4,3,2,0,1,0.47712125471966244,0.47712125471966244,0.17609125905568124])")
ANALYTICS_METHOD(TextLsa,"chem_text_lsa","text_lsa","Partial SVD of supplied nonnegative weighted DTM; args[k,preprocess0uncentered/1centered/2centered_scaled=2]; returns U,S,V and scores US with saved transform.","chem_text_lsa([[3,0],[0,2],[0,0]], [2,0])")
