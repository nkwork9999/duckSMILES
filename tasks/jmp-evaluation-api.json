  "source": "crates/analytics/src/evaluation.rs",
  "scope": "Prediction evaluation and partition index generation; no GUI or refitting. Binary curves are numerical outputs, multiclass one-vs-rest can be called per class.",
  "common_contract": {
    "input": "Finite rectangular nonempty matrix, <=100000 rows, <=1024 columns, <=1000000 cells; method constraints tighter. Optional nonnegative weights need finite positive sum; zero-weight rows do not contribute.",
    "null_fields": "Undefined precision/recall/R2 and unrepresentable scalar totals are JSON null; malformed shapes/domains return errors/SQL NULL.",
    "interpretation": "Evaluation rows and predictions must be supplied by caller from a properly isolated validation set; these routines cannot independently establish data provenance. Split indices are zero-based; they do not fit preprocessing.",
    "verification": "Public Rust behavior tests GREEN; production exported C ABI independent references PASS: 1140 cases/22209 numerical fields; native SQL gate pending."
  },
